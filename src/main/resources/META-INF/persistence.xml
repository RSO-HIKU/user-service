<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             version="2.2"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
                                 http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">

    <persistence-unit name="hikuPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <non-jta-data-source>jdbc/HikuDS</non-jta-data-source>

        <class>com.hiku.userService.model.User</class>

        <properties>
            <!-- JDBC configuration -->
            <!-- Comment below out and run mvn clean compile to generate locally .sql -->
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <!-- Comment above out and run mvn clean compile to generate locally .sql -->
            
            
            <!-- Hibernate dialect -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQL10Dialect"/>

            <property name="hibernate.c3p0.min_size" value="1"/>
            <property name="hibernate.c3p0.max_size" value="3"/>

            <!-- Generate SQL script without touching DB 
            <property name="javax.persistence.schema-generation.database.action" value="none"/>
            <property name="javax.persistence.schema-generation.scripts.action" value="create"/>
            <property name="javax.persistence.schema-generation.scripts.create-target" value="target/schema-user.sql"/>
            <property name="javax.persistence.schema-generation.create-source" value="metadata"/>
-->
            <!-- Optional: format the SQL nicely -->
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
